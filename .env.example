# === NCR Walk-in — environment template ===
# Copy to `.env.local` for local dev, and set the same values in your
# hosting provider's environment (Netlify: Site settings → Environment variables).

# --- Required: Supabase (create at https://supabase.com) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API → anon public key (safe for browsers; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: Razorpay payments (https://dashboard.razorpay.com) ---
# Leave blank to run the "Demo pay" mode (no real charge, activates listing immediately).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Optional: Admin PIN for /admin moderation ---
# Defaults to 499499 in app code if unset. Change this in production!
NEXT_PUBLIC_ADMIN_PIN=499499
